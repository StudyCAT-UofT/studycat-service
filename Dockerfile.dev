# Development image for the StudyCAT quiz engine service.
#
# Dependencies and the generated Prisma client live in the image (/opt/venv);
# the source tree is bind-mounted at /app at runtime so uvicorn can hot-reload.
# Rebuild the image after changing dependencies or the schema submodule.
#
# Used by docker-compose.yml in the studycat repository.

FROM python:3.12-slim-bookworm

# Prisma's query engine needs OpenSSL; Node.js needs libatomic
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates libatomic1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.9.21 /uv /uvx /bin/

# Node.js for `prisma generate`. With Node on PATH, prisma-client-py uses it instead of
# downloading the latest release via nodeenv, which breaks whenever nodejs.org lists a
# pre-release version that nodeenv cannot parse.
COPY --from=node:22.23.4-bookworm-slim /usr/local/bin/node /usr/local/bin/
COPY --from=node:22.23.4-bookworm-slim /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --frozen --no-install-project

COPY external/studycat-schema/schema.prisma external/studycat-schema/schema.prisma
RUN prisma generate --schema external/studycat-schema/schema.prisma --generator py

EXPOSE 8000

CMD ["uvicorn", "studycat_service.main:app", "--app-dir=src", "--reload", "--reload-dir=src", \
     "--host=0.0.0.0", "--port=8000"]
